# Canonical origin. Used for metadata, hreflang, the sitemap and OG images.
# Setting this also switches the site from noindex to indexable, so set it
# only once the domain actually resolves.
NEXT_PUBLIC_SITE_URL=https://inflexion2.com

# Calendly booking link for section 009. Optional: the production link is
# defaulted in lib/site.ts, so this only overrides it for testing.
NEXT_PUBLIC_BOOKING_URL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX).
# Empty means no analytics script loads at all — no request to Google and no
# cookies. The privacy policy reads this too and describes the site
# accordingly, so leaving it blank keeps the page truthful.
NEXT_PUBLIC_GA_ID=

# Animated hero scene on phones/tablets (<1024px). Default: true.
# Set to false to serve the static poster on mobile instead — this is the main
# lever for mobile Lighthouse performance (see README deployment notes).
NEXT_PUBLIC_HERO_SCENE_MOBILE=true
