# Canonical origin. Used for metadata, hreflang, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=https://inflexion.ca

# Cal.com booking link, e.g. https://cal.com/mono-awad/consultation
# Leave empty and section 009 renders a plain outlined link instead of the embed.
NEXT_PUBLIC_BOOKING_URL=

# Animated hero scene on phones/tablets (<1024px). Default: true.
# Set to false to serve the static poster on mobile instead — this is the main
# lever for mobile Lighthouse performance (see README deployment notes).
NEXT_PUBLIC_HERO_SCENE_MOBILE=true
